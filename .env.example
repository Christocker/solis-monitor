# Copy this file to .env and fill in your Supabase project details.
# NEVER commit .env to git (it is gitignored).

# Supabase project URL (Dashboard > Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The service_role key (server-side only). NEVER put this in the website.
SUPABASE_SERVICE_KEY=your-service-role-key-here
