# Copy this file to .env and fill in your Supabase project details.
# NEVER commit .env to git (it is gitignored).

# Supabase project URL (Dashboard > Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The service_role key (server-side only). NEVER put this in the website.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: push alerts to ntfy.sh (phone notifications).
# Set the topic to a long random string; NTFY_URL/NTFY_TOKEN are optional.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=

# --- Grid control (SONOFF relay through Home Assistant) ---
# Long-lived access token: Home Assistant > profile > Security > Long-lived
# access tokens. The relay is driven by the inverter's own battery SOC.
# SONOFF_HA_URL=http://127.0.0.1:8123
# SONOFF_HA_TOKEN=
# SONOFF_ENTITY=switch.minir4_solis_grid_control_sonoff_1002990982_1
# SONOFF_ON_SOC=8
# SONOFF_OFF_SOC=10
# SONOFF_MANUAL_HOLD_S=1800

# --- Dashboard access ---
# Devices whose MAC is listed skip the password; anything else must sign in.
# Loopback and this machine's own addresses are always allowed.
# DASHBOARD_ALLOWED_MACS=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66
# DASHBOARD_PASSWORD=
